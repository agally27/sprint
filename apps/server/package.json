{
  "name": "@sprint/server",
  "version": "0.1.0",
  "private": true,
  "description": "Sprint API \u2014 keeps AI, voice and image provider keys server-side.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:vercel": "node scripts/build-vercel.mjs",
    "smoke:vercel": "node scripts/smoke-vercel.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@hono/node-server": "^2.1.3",
    "@sprint/core": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
