# Sprint API. Every variable is optional; features degrade to local modes without them.

PORT=8787
NODE_ENV=development
CORS_ORIGINS=*
# Shared secret the app sends as "Authorization: Bearer …" (leave empty to disable)
SPRINT_API_TOKEN=

# AI planning (Anthropic). Without a key, plans come from the local planner.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Voice synthesis (ElevenLabs). Without a key, /api/tts returns 503 and the app uses the device voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Mission artwork: "mock" (palettes, no key) or "none"
IMAGE_PROVIDER=mock

# Requests per minute per client
RATE_LIMIT_PER_MINUTE=30
