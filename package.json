{
  "name": "sprint",
  "private": true,
  "version": "0.1.0",
  "description": "Sprint \u2014 turn goals into momentum.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "app": "pnpm --filter @sprint/app start",
    "web": "pnpm --filter @sprint/app web",
    "server": "pnpm --filter @sprint/server dev",
    "build:web": "pnpm --filter @sprint/app build:web",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @sprint/app exec playwright test e2e/journeys.spec.ts",
    "shots": "SHOTS=1 pnpm --filter @sprint/app exec playwright test e2e/visual.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "serve": "^14.2.6"
  }
}
